{
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "settings": {}
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "anytls",
      "settings": {
        "address": "anytls.example",
        "port": 443,
        "password": "synthetic-example-anytls-password",
        "idle_session_check_interval": "30s",
        "idle_session_timeout": "30s",
        "min_idle_session": 1,
        "client_metadata": "synthetic-client"
      },
      "streamSettings": {
        "network": "raw",
        "security": "tls",
        "tlsSettings": {
          "serverName": "anytls.example"
        }
      }
    }
  ],
  "dns": {
    "queryStrategy": "UseIPv4",
    "fakeIp": {
      "enabled": true,
      "ipv4Pool": "198.19.0.0/16",
      "poolSize": 32768,
      "ttl": 60
    }
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": []
  }
}
